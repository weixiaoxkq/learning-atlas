{
  "name": "learning-atlas",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "npm run validate && astro build && pagefind --site dist",
    "preview": "astro preview --host 0.0.0.0",
    "validate": "node --import tsx scripts/cli.ts validate",
    "test": "node --import tsx --test tests/*.test.ts",
    "course:new": "node --import tsx scripts/cli.ts course:new",
    "topic:new": "node --import tsx scripts/cli.ts topic:new",
    "progress": "node --import tsx scripts/cli.ts progress",
    "export": "node --import tsx scripts/cli.ts export",
    "maps": "node --import tsx scripts/cli.ts maps",
    "check": "astro check",
    "format": "prettier --write .",
    "study:context": "node --import tsx scripts/study.ts context",
    "study:start": "node --import tsx scripts/study.ts start",
    "study:checkpoint": "node --import tsx scripts/study.ts checkpoint",
    "study:finish": "node --import tsx scripts/study.ts finish",
    "study:close": "node --import tsx scripts/study.ts close"
  },
  "dependencies": {
    "astro": "^7.4.1",
    "katex": "^0.18.2",
    "marked": "^15.0.0",
    "marked-katex-extension": "^5.1.0",
    "markmap-lib": "^0.18.0",
    "markmap-view": "^0.18.0",
    "mermaid": "^12.2.0",
    "shiki": "^3.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/node": "^22.0.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
