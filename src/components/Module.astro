---
import { url } from '../lib/data';
const { module: m, course: c, progress: p } = Astro.props;
---

<details class="roadmap-module" open>
  <summary>{m.title}</summary>
  <ol>
    {m.topics.map((id: string) => {
      const t = c.topics.find((t: any) => t.id === id),
        s = p.topics[id].status;
      return (
        <li class:list={[{ current: p.current === id, unrecorded: s === 'not_started' }]}>
          <a href={url(`topics/${id}/`)}>{t.title}</a>
          <span class="node-label">
            {p.current === id ? '学到这里' : s === 'not_started' ? '尚未记录' : '已有记录'}
          </span>
        </li>
      );
    })}
  </ol>
  {m.children.map((child: any) => (
    <Astro.self module={child} course={c} progress={p} />
  ))}
</details>
